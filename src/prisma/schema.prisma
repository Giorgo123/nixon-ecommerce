generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  image       String // imagen de portada (cards, JSON-LD, emails, MP)
  category    String
  slug        String   @unique
  seo         String?
  active      Boolean  @default(true) // false = oculto de la tienda (soft-delete: preserva el historial de OrderItem)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
  images      ProductImage[] // fotos adicionales de galeria, no incluye la portada
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String   @id @default(cuid())
  size       String? // "S" | "M" | "L" | "XL" | "XXL" | null si el producto no maneja talles
  color      String? // modelado a futuro; no se expone en el admin todavia
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model Order {
  id             String   @id @default(cuid())
  email          String
  fullName       String
  phone          String
  deliveryMethod String   @default("shipping") // "shipping" | "pickup"
  address        String? // null si deliveryMethod = "pickup"
  city           String?
  state          String?
  zipCode        String?
  trackingInfo   String? // texto libre: transportista + numero de seguimiento
  paymentMethod  String   @default("mercadopago") // "mercadopago" | "transfer"
  couponCode     String?
  discountAmount Float    @default(0)
  totalPrice     Float
  status         String   @default("pending")
  paymentId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items OrderItem[]
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String // "percentage" | "fixed"
  value     Float // 10 = 10% si type=percentage, o $10 si type=fixed
  maxUses   Int? // null = ilimitado
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}