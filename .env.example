# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nixon_ecommerce"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="your_access_token_here"
# Secret de la firma HMAC que manda MP en el header x-signature del webhook
# (panel de MP > Tus integraciones > la app > Webhooks > "Firma secreta")
MERCADOPAGO_WEBHOOK_SECRET="your_webhook_secret_here"

# URL pública del sitio: localhost en dev, dominio real en producción
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# En producción: https://nixonstudio.com.ar

# Sesiones admin (JWT) y tokens de acceso a órdenes (/success). Usar un
# valor largo y aleatorio, distinto por entorno. Generar uno nuevo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change_me_to_a_long_random_string"

# Admin inicial: solo se usan al correr `npx prisma db seed` para crear
# (o resetear) el admin por defecto en la tabla Admin — el login valida
# contra el hash bcrypt guardado en la DB, no contra estas variables.
ADMIN_EMAIL="admin@nixonstudio.com"
ADMIN_PASSWORD="admin123"

# Resend (emails transaccionales: pedido recibido / pago confirmado)
RESEND_API_KEY="your_resend_api_key_here"
# Remitente verificado en Resend. Si no se configura, cae a
# "Nixon Studio <onboarding@resend.dev>" (alto riesgo de ir a spam).
STORE_FROM_EMAIL="Nixon Studio <pedidos@nixonstudio.com.ar>"
# A quién avisar por email cuando entra un pedido nuevo (opcional)
STORE_NOTIFICATION_EMAIL="pedidos@nixonstudio.com.ar"

# Vercel Blob (subida de imágenes de producto desde el admin)
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token_here"
